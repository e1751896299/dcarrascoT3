<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dcarrascoT3.Views.vLogin"
             Title="vLogin">

    <ContentPage.Resources>
        <Style x:Key="styLabel" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextColor" Value="blue"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="styleEntry" TargetType="Entry">
            <Setter Property="Background" Value="Beige"/>
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        
    </ContentPage.Resources>

    <VerticalStackLayout
        Padding="20"
        Spacing="15">
        
        <Label 
            Text="INICIO DE SESIÓN"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Image Source="login.jpeg"
               WidthRequest="130"/>

        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <Label Text="Usuario: "
                   Style="{StaticResource styLabel}"
                   Grid.Column="0"
                   Grid.Row="0"/>

            <Entry x:Name ="txtUsuario"
                   Style="{StaticResource styleEntry}"
                   Grid.Column="1"
                   Grid.Row="0"/>
            
            <Label Text="Contraseña: "
                   Style="{StaticResource styLabel}"
                   Grid.Column="0"
                   Grid.Row="1"/>

            <Entry x:Name="txtContraseña"
                    Style="{StaticResource styleEntry}"
                   IsPassword="True"
                   Grid.Column="1"
                   Grid.Row="1"/>

        </Grid>

        <Button x:Name="btnIniciarSesion"
        Text="Iniciar sesión"
        Style="{StaticResource BotonGlobal}"
        Clicked="btnIniciarSesion_Clicked"/>

        <Button x:Name="btnRegistrarUsuario"
        Text="Registrar usuario"
        Style="{StaticResource BotonGlobal}"
        Clicked="btnRegistrarUsuario_Clicked"/>


    </VerticalStackLayout>
</ContentPage>